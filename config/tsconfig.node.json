{
  //The config files in this folder and the scripts of the modules, which run in node
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": ["*.ts", "../package-*/*/scripts"]
}
