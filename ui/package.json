{
  "name": "@chocbite/ts-lib-ui",
  "version": "1.0.2",
  "author": "chocolateandmilkwin",
  "license": "MIT",
  "type": "module",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@forgejo.nsns.dk:2222/chocbite/ts-lib.git"
  },
  "description": "Browser UI TypeScript libraries, builds on @chocbite/ts-lib",
  "exports": {
    "./base": {
      "development": "./src/base/index.ts",
      "types": "./dist/base/index.d.mts",
      "import": "./dist/base/index.mjs",
      "style": "./dist/style.css"
    },
    "./canvas": {
      "development": "./src/canvas/index.ts",
      "types": "./dist/canvas/index.d.mts",
      "import": "./dist/canvas/index.mjs",
      "style": "./dist/style.css"
    },
    "./context-menu": {
      "development": "./src/context-menu/index.ts",
      "types": "./dist/context-menu/index.d.mts",
      "import": "./dist/context-menu/index.mjs",
      "style": "./dist/style.css"
    },
    "./document": {
      "development": "./src/document/index.ts",
      "types": "./dist/document/index.d.mts",
      "import": "./dist/document/index.mjs",
      "style": "./dist/style.css"
    },
    "./dom": {
      "development": "./src/dom/index.ts",
      "types": "./dist/dom/index.d.mts",
      "import": "./dist/dom/index.mjs",
      "style": "./dist/style.css"
    },
    "./form": {
      "development": "./src/form/index.ts",
      "types": "./dist/form/index.d.mts",
      "import": "./dist/form/index.mjs",
      "style": "./dist/style.css"
    },
    "./icons": {
      "development": "./src/icons/index.ts",
      "types": "./dist/icons/index.d.mts",
      "import": "./dist/icons/index.mjs",
      "style": "./dist/style.css"
    },
    "./keyboard": {
      "development": "./src/keyboard/index.ts",
      "types": "./dist/keyboard/index.d.mts",
      "import": "./dist/keyboard/index.mjs",
      "style": "./dist/style.css"
    },
    "./list": {
      "development": "./src/list/index.ts",
      "types": "./dist/list/index.d.mts",
      "import": "./dist/list/index.mjs",
      "style": "./dist/style.css"
    },
    "./selection": {
      "development": "./src/selection/index.ts",
      "types": "./dist/selection/index.d.mts",
      "import": "./dist/selection/index.mjs",
      "style": "./dist/style.css"
    },
    "./settings": {
      "development": "./src/settings/index.ts",
      "types": "./dist/settings/index.d.mts",
      "import": "./dist/settings/index.mjs",
      "style": "./dist/style.css"
    },
    "./spinner": {
      "development": "./src/spinner/index.ts",
      "types": "./dist/spinner/index.d.mts",
      "import": "./dist/spinner/index.mjs",
      "style": "./dist/style.css"
    },
    "./svg": {
      "development": "./src/svg/index.ts",
      "types": "./dist/svg/index.d.mts",
      "import": "./dist/svg/index.mjs",
      "style": "./dist/style.css"
    },
    "./theme": {
      "development": "./src/theme/index.ts",
      "types": "./dist/theme/index.d.mts",
      "import": "./dist/theme/index.mjs",
      "style": "./dist/style.css"
    },
    "./viewport": {
      "development": "./src/viewport/index.ts",
      "types": "./dist/viewport/index.d.mts",
      "import": "./dist/viewport/index.mjs",
      "style": "./dist/style.css"
    },
    "./icons/mixins": "./dist/icons/mixins.scss",
    "./theme/mixins": "./dist/theme/mixins.scss"
  },
  "imports": {
    "#base": "./src/base/index.ts",
    "#canvas": "./src/canvas/index.ts",
    "#context-menu": "./src/context-menu/index.ts",
    "#document": "./src/document/index.ts",
    "#dom": "./src/dom/index.ts",
    "#form": "./src/form/index.ts",
    "#icons": "./src/icons/index.ts",
    "#keyboard": "./src/keyboard/index.ts",
    "#list": "./src/list/index.ts",
    "#selection": "./src/selection/index.ts",
    "#settings": "./src/settings/index.ts",
    "#spinner": "./src/spinner/index.ts",
    "#svg": "./src/svg/index.ts",
    "#theme": "./src/theme/index.ts",
    "#viewport": "./src/viewport/index.ts"
  },
  "scripts": {
    "build": "tsdown && node -e \"for (const m of ['icons','theme']) require('fs').cpSync('src/'+m+'/mixins.scss','dist/'+m+'/mixins.scss')\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "check-deps": "npx depcheck"
  },
  "dependencies": {
    "@chocbite/ts-lib": "^1.0.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.0",
    "@vitest/browser-playwright": "^5.0.1",
    "sass-embedded": "^1.104.1"
  }
}
