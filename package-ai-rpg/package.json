{
  "name": "@chocbite/ai-rpg",
  "description": "Text based AI RPG, built on @chocbite/ts-lib and @chocbite/ts-lib-ui",
  "author": "chocolateandmilkwin",
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "npm run typecheck && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "typecheck": "tsc -b",
    "lint": "eslint --config config/eslint.config.js src",
    "vitest": "vitest --config config/vite.config.ts",
    "test": "npm run typecheck && vitest run --config config/vite.config.ts"
  },
  "imports": {
    "#*": "./src/*/index.ts"
  },
  "dependencies": {
    "@chocbite/ts-lib": "*",
    "@chocbite/ts-lib-ui": "*"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "@vitest/browser-playwright": "^5.0.1",
    "eslint": "^10.12.0",
    "sass-embedded": "^1.104.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  }
}
